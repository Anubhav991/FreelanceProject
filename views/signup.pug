extends base.pug 
block style 
    style 
        include ../static/style1.css
        include ../static/signup.css
block content
    section#sectioncontactus
        div.bgvid1
                <video autoplay loop muted plays-inline class = "backgroundvid1">
                <source src = '..\static\videoplayback.mp4' type = "video/mp4" >
                </video>
        h1 Sign Up
        form(id = "form1" , action="/signup" ,method="post")
            <input type="text" name="firstname" placeholder="Enter first name">
            <input type="text" name="surname" placeholder="Enter your surname">
            <input type="email" name="emailid" placeholder="Enter your email">
            <input type="phone" name="phoneno" placeholder="Enter your phone no.">
            <input type="text" name="username" placeholder="Enter your username">
            <input type="password" name="password" placeholder="Enter your password">
            <button id = "bt1" , type="submit">Submit</button>